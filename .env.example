# Salin file ini menjadi `.env` lalu isi dengan nilai dari Supabase Dashboard
# (Project Settings → API). Jangan commit `.env` — ia sudah di-ignore.
# Nilai anon key aman untuk publik; jangan pernah meletakkan service_role key di sini.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
